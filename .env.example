# ============================================================
# FinGuard 2026 — Environment Configuration
# Copy to .env and fill in values
# ============================================================

# ─── Application ────────────────────────────────────────────
APP_NAME=finguard
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ─── API Gateway ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_KEY=changeme-generate-a-secure-key
API_RATE_LIMIT_RPM=120       # requests per minute

# ─── Kafka ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTION_TOPIC=transactions
KAFKA_CONSUMER_GROUP=finguard-consumer
KAFKA_AUTO_OFFSET_RESET=latest

# ─── Feature Store (Feast) ──────────────────────────────────
FEAST_REPO_PATH=./feature_store
FEAST_ONLINE_STORE_TYPE=sqlite      # sqlite | redis
FEAST_REDIS_HOST=localhost
FEAST_REDIS_PORT=6379

# ─── Model Configuration ────────────────────────────────────
MODEL_CHECKPOINT_DIR=./artifacts/checkpoints
MODEL_DEVICE=cpu                     # cpu | cuda | cuda:0
MODEL_GRAPH_HIDDEN=256
MODEL_GRAPH_LAYERS=3
MODEL_TRANSFORMER_D_MODEL=128
MODEL_TRANSFORMER_NHEAD=8
MODEL_TRANSFORMER_LAYERS=4
MODEL_MAX_SEQ_LEN=64

# ─── Federated Learning (Flower) ────────────────────────────
FL_SERVER_ADDRESS=0.0.0.0:8080
FL_NUM_ROUNDS=10
FL_MIN_FIT_CLIENTS=2
FL_MIN_EVALUATE_CLIENTS=2
FL_FRACTION_FIT=1.0

# ─── Monitoring ─────────────────────────────────────────────
PROMETHEUS_PORT=9090
DRIFT_THRESHOLD=0.1
DRIFT_ALPHA=0.01
DRIFT_CHECK_INTERVAL_SEC=3600

# ─── Database (for audit logs) ──────────────────────────────
DATABASE_URL=sqlite:///./finguard.db

# ─── GST Portal / GSP Filing ─────────────────────────────────────────
# Real GST filing requires authorized GSTN/GSP credentials and taxpayer auth.
# Leave disabled unless your GSP has supplied these values.
GST_PORTAL_ENABLED=false
GST_PORTAL_BASE_URL=https://your-authorized-gsp.example
GST_PORTAL_SUBMIT_RETURN_PATH=/returns/gstr3b/file
GST_PORTAL_AUTH_TOKEN=
GST_PORTAL_CLIENT_ID=
GST_PORTAL_CLIENT_SECRET=
GST_PORTAL_TAXPAYER_USERNAME=
GST_PORTAL_RETURN_TYPE=GSTR3B
GST_PORTAL_TIMEOUT_SECONDS=30
